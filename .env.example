# ==========================================================================
# Configuração do Finanças Pessoais — copie para .env e preencha
# NUNCA versione o arquivo .env (ele está no .gitignore)
# ==========================================================================

# --- Banco de dados ---
# SQLite (padrão, zero configuração). Para produção/VPS, use Postgres:
#   DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/financas
DATABASE_URL=sqlite:///data/financas.db

# --- Segurança do dashboard ---
# Token simples exigido no header "X-App-Token" ou query ?token= para acessar.
# Gere um valor forte: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=troque-me-por-um-token-forte

# --- Pluggy (Open Finance - conexão automática). Opcional. ---
# Crie em https://dashboard.pluggy.ai (há tier gratuito/trial para uso pessoal).
# Deixe em branco para rodar só no modo de importação de arquivos (OFX/CSV/PDF).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# --- Categorização por LLM (opcional). ---
# Se vazio, usa só o motor de regras PT-BR (funciona offline, sem custo).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Moeda / localização ---
DEFAULT_CURRENCY=BRL
TIMEZONE=America/Sao_Paulo
